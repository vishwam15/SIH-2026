# DisasterShield AI (SIH 2026) Environment Configuration
# Copy this file to .env and adjust variables as needed.

# =====================================================================
# 1. Frontend & API Gateways
# =====================================================================
# Node.js Express Backend API endpoint
VITE_API_URL=http://localhost:5002/api

# Python FastAPI AI / Telemetry Engine endpoint
VITE_FASTAPI_URL=http://localhost:8000/api/v1

# =====================================================================
# 2. Maps & Geospatial Services (Optional API Keys)
# =====================================================================
# Mapbox Access Token (Optional: Leaflet uses high-speed Carto Dark basemaps by default)
# Get a free key at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# MapTiler Cloud Key (Optional: for vector tile styles)
# Get a free key at: https://cloud.maptiler.com/
VITE_MAPTILER_KEY=

# OpenWeatherMap API Key (Optional: Live weather fallback)
VITE_OPENWEATHER_API_KEY=

# =====================================================================
# 3. Node.js Backend Server Settings (server/.env)
# =====================================================================
PORT=5002
USE_MEMORY_DB=true
MONGO_URI=mongodb://127.0.0.1:27017/disastershield
JWT_SECRET=disastershield_super_secure_jwt_secret_key_2026
ML_SERVICE_URL=http://127.0.0.1:8000
